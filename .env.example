# Copy this file to .env and fill in your real values.
# NEVER commit the real .env file (it contains secrets).

# AI assistant (Groq) - get a free key at https://console.groq.com
GROQ_API_KEY=

# Optional PostgreSQL URL. If empty, contact messages are stored in local SQLite (contacts.db)
DATABASE_URL=

# Optional Telegram notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# SMTP email (Gmail works - use an App Password, not your normal password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_EMAIL=
SMTP_PASSWORD=
MAIL_TO=

# Admin panel login (http://localhost:5000/admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=

# Flask session secret
SECRET_KEY=
